{
  "name": "@bp/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --packages=external --alias:@bp/shared=../shared/src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@bp/shared": "*",
    "@colyseus/schema": "5.0.43",
    "@colyseus/ws-transport": "0.18.4",
    "express": "5.1.0",
    "zod": "4.6.7",
    "@colyseus/core": "0.18.23"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.0",
    "esbuild": "0.25.10",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
